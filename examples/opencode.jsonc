{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "router-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Local Router (Anthropic)",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "best": {
          "name": "Best available via RouteTok"
        }
      }
    },
    "router-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Router (OpenAI)",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "best": {
          "name": "Best OpenAI-compatible model via RouteTok"
        }
      }
    }
  },
  "model": "router-anthropic/best"
}
