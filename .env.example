# Rotate any key that has been pasted into chat or logs before using it here.
# Configure any paid inference providers you want. OpenCode Zen free routes work anonymously.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional management key enables organization-wide credit totals.
OPENROUTER_MANAGEMENT_KEY=

REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1
REQUESTY_MANAGEMENT_BASE_URL=https://api-v2.requesty.ai

# Optional trusted local Speaches API root. The model defaults to Systran/faster-whisper-small.
LOCAL_STT_BASE_URL=
LOCAL_STT_MODEL=
# Optional bearer credential; leave empty when Speaches does not require authentication.
LOCAL_STT_API_KEY=

# OpenCode Zen is restricted by the proxy to its verified free-model whitelist.
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# Optional; free routes use the public credential when omitted.
OPENCODE_ZEN_API_KEY=

KIMI_CODING_API_KEY=
KIMI_CODING_BASE_URL=https://api.kimi.com/coding/v1

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.ai/v1
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# One startup-configured generic OpenAI-compatible API root. Treat this destination as trusted.
GENERIC_OPENAI_BASE_URL=
GENERIC_OPENAI_API_KEY=
GENERIC_OPENAI_AUTH=bearer
GENERIC_OPENAI_SUPPORTS_RESPONSES=false
# Required for local HTTP endpoints such as vLLM, LM Studio, or Ollama compatibility servers.
GENERIC_OPENAI_ALLOW_PRIVATE=false

# Local defaults. Keep HOST loopback-only unless you add network-level protection.
HOST=127.0.0.1
PORT=8787

# Optional: require this key from OpenAI/Anthropic clients connecting to the proxy.
PROXY_API_KEY=

# Optional: protects dashboard JSON and mutation endpoints.
DASHBOARD_TOKEN=

# Runtime state is stored outside source files and never contains upstream secrets.
DATA_DIR=./data

# Docker Compose host publishing only; these do not change the in-container port.
ROUTETOK_DOCKER_BIND=127.0.0.1
ROUTETOK_DOCKER_PORT=8787
